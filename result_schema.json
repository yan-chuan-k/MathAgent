{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_id",
    "problem_type",
    "task_type",
    "domain_candidates",
    "reasoning_plan",
    "solution",
    "final_answer",
    "verification",
    "learning_hints",
    "_meta"
  ],
  "properties": {
    "problem_id": {
      "type": "string"
    },
    "problem_type": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": ["calculation", "proof", "derivation", "choice", "classification", "construction", "counterexample", "unknown"]
    },
    "domain_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasoning_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "solution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "content"],
        "properties": {
          "step": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "final_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "answer_type"],
      "properties": {
        "answer": {
          "type": "string"
        },
        "answer_type": {
          "type": "string",
          "enum": ["numeric", "expression", "closed_form", "proof", "set", "interval", "matrix", "vector", "function", "distribution", "choice", "boolean", "text", "unknown"]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_result",
        "verification_process",
        "confidence"
      ],
      "properties": {
        "verification_result": {
          "type": "string",
          "enum": ["pass", "fail", "uncertain"]
        },
        "verification_process": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verifier",
              "claim_id",
              "status",
              "method",
              "details",
              "residual",
              "assumptions",
              "verification_level",
              "is_decisive"
            ],
            "properties": {
              "verifier": {
                "type": "string"
              },
              "claim_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["pass", "fail", "inconclusive"]
              },
              "method": {
                "type": "string"
              },
              "details": {
                "type": "string"
              },
              "residual": {
                "type": ["string", "null"]
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verification_level": {
                "type": "string",
                "enum": [
                  "formal",
                  "exact_symbolic",
                  "exact_enumeration",
                  "high_precision_numeric",
                  "randomized_sanity",
                  "model_critic",
                  "completeness_only"
                ]
              },
              "is_decisive": {
                "type": "boolean"
              },
              "claim_scope": {
                "type": "string",
                "enum": ["full_answer", "subclaim"]
              }
            }
          }
        },
        "issues": {
          "type": ["array", "string", "object"]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "arguments"],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "symbolic_equivalence",
              "equation_solution",
              "equation_solution_set",
              "numeric_arithmetic",
              "derivative_check",
              "integral_check",
              "matrix_determinant",
              "matrix_multiply",
              "matrix_inverse",
              "linear_system_residual",
              "matrix_rank",
              "eigenpair_residual",
              "vector_orthogonality",
              "vector_normalization",
              "matrix_equivalence",
              "vector_equivalence",
              "small_case_enumeration",
              "recurrence_check",
              "modular_check"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "claim_id": {
            "type": "string"
          }
        }
      }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "backend",
        "attempts",
        "schema_valid",
        "schema_error",
        "content_complete",
        "answer_verified",
        "proof_verified",
        "overall_status",
        "failure_kind",
        "failure_details",
        "elapsed_seconds"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "backend": {
          "type": "string",
          "enum": ["simple", "lagent"]
        },
        "attempts": {
          "type": "integer"
        },
        "schema_valid": {
          "type": "boolean"
        },
        "schema_error": {
          "type": ["string", "null"]
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "content_complete": {
          "type": "boolean"
        },
        "answer_verified": {
          "type": "boolean"
        },
        "proof_verified": {
          "type": "boolean"
        },
        "overall_status": {
          "type": "string",
          "enum": ["solved", "probable", "uncertain", "invalid", "error"]
        },
        "failure_kind": {
          "type": ["string", "null"],
          "enum": [
            "json_parse",
            "schema",
            "wrong_final_answer",
            "symbolic_contradiction",
            "numeric_residual",
            "missing_case",
            "unsupported_lemma",
            "circular_reasoning",
            "low_consensus",
            "inconclusive",
            null
          ]
        },
        "failure_details": {
          "type": "string"
        }
      }
    }
  }
}
